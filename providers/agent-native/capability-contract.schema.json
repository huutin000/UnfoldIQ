{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unfoldiq.local/schemas/agent-native/capability-contract.schema.json",
  "title": "Agent-native capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionId", "agentName", "capabilities", "declaredAt"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "agentName": { "type": "string", "minLength": 1 },
    "toolName": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["image", "video", "tts", "stt"] }
    },
    "declaredAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "string" }
  }
}
