{
  "manifest_version": 3,
  "name": "UNFOLDIQ Flow Companion",
  "short_name": "Flow Companion",
  "version": "0.5.3",
  "description": "Companion extension for connecting UNFOLDIQ with Google Flow, with live diagnostics, approval-gated generation, result download and asset import.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "sidePanel",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "https://labs.google/fx/*",
    "https://flow.google/*",
    "https://flow.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/*",
        "https://flow.google/*",
        "https://flow.google.com/*"
      ],
      "js": [
        "src/content/flow-page-adapter.js",
        "src/content/content-commands.js",
        "src/content/content-runtime.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/sidepanel.html"
  },
  "action": {
    "default_title": "UNFOLDIQ Flow Companion",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
