# UNFOLDIQ Environment Variables Example
# Copy to .env and fill in actual values
# NEVER commit actual .env with real secrets
# Shell environment always wins over .env (Node process.loadEnvFile semantics)

# --- LLM / embedding providers (provider:model syntax) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
FAST_LLM=google_genai:gemini-3.5-flash-lite
SMART_LLM=google_genai:gemini-3.5-flash
STRATEGIC_LLM=google_genai:gemini-3.5-flash
# Gemini-only deep research: explicit embedding beats the library's openai default
EMBEDDING=google_genai:gemini-embedding-001

# --- Search retrievers ---
RETRIEVER=duckduckgo
TAVILY_API_KEY=
SERPER_API_KEY=

# --- Media / voice ---
ELEVENLABS_API_KEY=

# --- Live-test approval (NEVER persist in .env; session-only operator opt-in) ---
# Set temporarily in the executing shell: $env:UNFOLDIQ_DEEP_LIVE_TEST_ALLOWED="1"
# UNFOLDIQ_DEEP_LIVE_TEST_ALLOWED=
