# UNFOLDIQ ignore policy — research acquisition (Prompt 02) + standards.
# Never commit: venvs, Python bytecode, crawler caches, auth state, secrets.

# Dedicated research venv (reproducible via research/requirements.txt)
research/.venv/
# Dedicated DEEP provider venv (reproducible via research/deep-requirements.txt)
research/.venv-deep/
.venv/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo
*.pyd

# Crawl4AI local data (DB, caches, downloaded models live outside repo)
/.crawl4ai/

# Browser auth state = credential material (lives under %LOCALAPPDATA%/UNFOLDIQ or ~/.unfoldiq)
**/auth-state/
*.auth.json
*storage-state*.json

# Dependencies / build output
node_modules/
out/

# POST-1H workspace governance: lifecycle EPHEMERAL/REGENERABLE paths.
# Canonical evidence lives in tracked dirs with explicit names
# (*.jsonl, Report/, golden/, projects/); these patterns cover only
# proven-disposable scratch (run tmp, rebuildable caches, agent dumps).
**/tmp/
**/cache/
*.tmp
.playwright-cli/

# Playwright test output
playwright-report/
test-results/

# Local env secrets
.env
.env.*
!.env.example


# SAC-blocked Remotion binaries runtime dir (non-committed, Fix 6)
remotion/.render-binaries/
