{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "platform-adaptation.schema.json",
  "title": "UNFOLDIQ Platform Adaptation Artifact (1G.7)",
  "description": "Per-target presentation adaptation of a master composition. Policy only — no rendering, no model selection, no story rewrite.",
  "type": "object",
  "required": ["version", "adaptationId", "shotId", "platformId", "sourceCompositionId", "sourceFingerprint", "targetAspectRatio", "action", "regenerationDecision", "fingerprint", "status"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "adaptationId": { "type": "string", "pattern": "^pa-[0-9a-f]{12}$" },
    "projectId": { "type": ["string", "null"] },
    "sceneId": { "type": ["string", "null"] },
    "shotId": { "type": "string" },
    "platformId": { "enum": ["YOUTUBE_LONG", "YOUTUBE_SHORTS", "TIKTOK"] },
    "platformProfileVersion": { "type": ["string", "null"] },
    "platformProfileFingerprint": { "type": ["string", "null"] },
    "safeZoneEvidenceVersion": { "type": ["string", "null"] },
    "sourceCompositionId": { "type": "string", "pattern": "^mc-[0-9a-f]{12}$" },
    "sourceFingerprint": { "type": "string" },
    "sourceModality": { "type": ["string", "null"] },
    "sourceRenderMode": { "type": ["string", "null"] },
    "targetAspectRatio": { "type": "string", "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?$" },
    "action": { "enum": ["PRESERVE", "REFRAME", "REFRAME_AND_RELAYOUT", "RELAYOUT", "RECOMPOSE", "REVIEW_REQUIRED", "REGENERATE_REQUIRED"] },
    "cropPlan": { "type": ["object", "null"] },
    "reframePlan": { "type": ["object", "null"] },
    "relayoutPlan": { "type": ["object", "null"] },
    "recomposeAssets": { "type": "array", "items": { "type": "string" } },
    "textPlan": { "type": "object" },
    "captionPlan": { "type": "object" },
    "graphicPlan": { "type": "object" },
    "densityGuidance": { "type": "object" },
    "pacingGuidance": { "type": "object" },
    "preservedIntent": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "regenerationDecision": { "enum": ["NOT_REQUIRED", "TARGETED_REGENERATION_REQUIRED", "REVIEW_REQUIRED"] },
    "regenerationReasons": { "type": "array", "items": { "type": "string" } },
    "sourceRefs": { "type": "array", "items": { "type": "string" } },
    "policyVersion": { "type": ["string", "null"] },
    "overrideState": { "type": ["string", "null"] },
    "overrideReason": { "type": ["string", "null"] },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "status": { "enum": ["ADAPTED", "REVIEW_REQUIRED", "STALE"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
