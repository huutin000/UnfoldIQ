{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "instruction-sync.schema.json",
  "title": "UNFOLDIQ Instruction Sync Artifact (1G.9)",
  "description": "Desired-vs-provider sync state for one instruction set. APPLIED never implies VERIFIED; verification needs readback + semantic compare evidence.",
  "type": "object",
  "required": ["version", "syncId", "projectId", "instructionSetId", "instructionVersion", "desiredFingerprint", "syncStatus"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "syncId": { "type": "string", "pattern": "^sy-[0-9a-f]{12}$" },
    "projectId": { "type": "string" },
    "instructionSetId": { "type": "string" },
    "instructionVersion": { "type": "string" },
    "desiredFingerprint": { "type": "string" },
    "provider": { "type": "string" },
    "providerProjectRef": { "type": ["string", "null"] },
    "applyAttemptId": { "type": ["string", "null"] },
    "applyStatus": { "type": "string" },
    "appliedAt": { "type": ["string", "null"] },
    "readbackStatus": { "type": "string" },
    "readbackFingerprint": { "type": ["string", "null"] },
    "readbackAt": { "type": ["string", "null"] },
    "semanticCompareStatus": { "type": "string" },
    "differences": { "type": "array" },
    "referenceBindings": { "type": "array" },
    "automationMode": { "enum": ["HANDS_FREE", "OPERATOR_ASSISTED", null] },
    "writeTransport": { "type": ["string", "null"] },
    "operatorTextEntry": { "type": ["boolean", "null"] },
    "previousSyncRef": { "type": ["string", "null"], "pattern": "^sy-[0-9a-f]{12}$" },
    "verifiedAt": { "type": ["string", "null"] },
    "syncStatus": { "type": "string" },
    "evidenceRefs": { "type": "array", "items": { "type": "string" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
