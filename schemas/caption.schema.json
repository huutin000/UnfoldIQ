{
  "$id": "https://unfoldiq.io/schemas/caption.schema.json",
  "title": "UNFOLDIQ Caption Artifact Contract (Phase 2.10)",
  "description": "Versioned caption events derived from canonical spoken text + AlignmentArtifact, with QA findings and input hashes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "alignmentVersion", "narrationTimingHash", "profileRef", "mode", "events", "qaStatus", "inputHashes", "createdAt"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "projectId": { "type": "string", "minLength": 1 },
    "alignmentVersion": { "type": "string", "minLength": 1 },
    "narrationTimingHash": { "type": "string", "minLength": 8 },
    "profileRef": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["DIALOGUE_ONLY", "ACCESSIBLE_CAPTIONS"] },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["captionId", "startMs", "endMs", "text", "lines", "presentation", "locked"],
        "properties": {
          "captionId": { "type": "string", "minLength": 1 },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "text": { "type": "string", "minLength": 1 },
          "lines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "speakerId": { "type": "string" },
          "speakerLabel": { "type": "string" },
          "wordIds": { "type": "array", "items": { "type": "string" } },
          "nonSpeechEventRef": { "type": "string" },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode"],
            "properties": {
              "mode": { "enum": ["BLOCK", "WORD_HIGHLIGHT", "SINGLE_WORD"] },
              "anchor": { "type": "string" },
              "safeZoneRef": { "type": "string" }
            }
          },
          "locked": { "type": "boolean" }
        }
      }
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "findings"],
      "properties": {
        "status": { "enum": ["PASS", "REVIEW_REQUIRED", "FAIL"] },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "reason", "correctiveAction"],
            "properties": {
              "code": { "type": "string" },
              "captionId": { "type": "string" },
              "segmentId": { "type": "string" },
              "wordId": { "type": "string" },
              "startMs": { "type": "integer" },
              "endMs": { "type": "integer" },
              "reason": { "type": "string" },
              "correctiveAction": {
                "enum": [
                  "REALIGN_SEGMENT", "RESEGMENT_CAPTION", "MERGE_CAPTIONS", "SPLIT_CAPTION",
                  "ADJUST_TIMING", "FIX_SPEAKER_LABEL", "ADD_AUDIO_CUE", "REMOVE_DUPLICATE",
                  "CHANGE_PROFILE", "REVIEW_REQUIRED"
                ]
              }
            }
          }
        },
        "metrics": { "type": "object" }
      }
    },
    "qaStatus": { "enum": ["PASS", "REVIEW_REQUIRED", "FAIL"] },
    "inputHashes": { "type": "object", "additionalProperties": { "type": "string" } },
    "createdAt": { "type": "string" }
  }
}
