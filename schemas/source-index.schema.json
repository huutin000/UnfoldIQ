{
  "$id": "https://unfoldiq.io/schemas/source-index.schema.json",
  "title": "UNFOLDIQ Source Registry Index (1G.1G)",
  "description": "Persistent traceable source records. Records sources; declares no claim true. Bodies live under research/sources/, referenced not duplicated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "projectId",
    "sources"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "planRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topic": { "type": "string" },
        "planHash": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "sourceVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentHash", "retrievedAt", "rawContentRef"],
      "properties": {
        "contentHash": { "type": "string", "minLength": 8 },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "rawContentRef": { "type": "string", "minLength": 1 },
        "fitContentRef": { "type": ["string", "null"] },
        "supersedes": { "type": ["string", "null"] }
      }
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "requestedUrl",
        "canonicalUrl",
        "finalUrl",
        "retrievedAt",
        "sourceType",
        "independenceStatus",
        "contentHash",
        "currentVersionHash",
        "versions",
        "acquisitionRoute",
        "acquisitionWarnings"
      ],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^src-[0-9a-f]{12}$" },
        "requestedUrl": { "type": "string", "minLength": 1 },
        "canonicalUrl": { "type": "string", "minLength": 1 },
        "finalUrl": { "type": "string", "minLength": 1 },
        "title": { "type": ["string", "null"] },
        "publisher": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "publishedAt": { "type": ["string", "null"] },
        "retrievedAt": { "type": "string", "format": "date-time" },
        "sourceType": {
          "type": "string",
          "enum": ["PRIMARY", "OFFICIAL", "REPUTABLE_SECONDARY", "COMMUNITY", "SOCIAL", "FOLKLORE", "UNKNOWN"]
        },
        "classificationReason": { "type": "string" },
        "independenceStatus": {
          "type": "string",
          "enum": ["INDEPENDENT", "DERIVED", "SYNDICATED", "COPY_CHAIN", "UNKNOWN"]
        },
        "originGroup": { "type": ["string", "null"] },
        "searchQuery": { "type": ["string", "null"] },
        "searchProvider": { "type": ["string", "null"] },
        "searchRank": { "type": ["number", "null"] },
        "contentHash": { "type": "string", "minLength": 8 },
        "currentVersionHash": { "type": "string", "minLength": 8 },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceVersion" }
        },
        "acquisitionRoute": { "type": "string", "minLength": 1 },
        "crawlerVersion": { "type": ["string", "null"] },
        "fitQuery": { "type": ["string", "null"] },
        "acquisitionWarnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
