{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "golden.schema.json",
  "title": "UNFOLDIQ Golden Projects / Quality Regression (1H.5)",
  "description": "Versioned golden definitions, append-only baselines, persisted comparisons and canary verdicts. Metric values reference canonical evidence; judgment metrics carry reviewer/method/confidence.",
  "definitions": {
    "definitionsDoc": {
      "type": "object",
      "required": ["schemaVersion", "revision", "createdAt", "updatedAt", "definitions", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "definitions": { "type": "object", "additionalProperties": { "$ref": "#/definitions/goldenProject" } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "goldenProject": {
      "type": "object",
      "required": ["goldenProjectId", "version", "name", "categories", "fixture", "contentClass", "platform", "aspectRatio", "requiredCapabilities", "expectedArtifacts", "evaluationProfile", "status"],
      "additionalProperties": false,
      "properties": {
        "goldenProjectId": { "type": "string", "pattern": "^gold-[0-9a-z-]{1,64}$" },
        "version": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "categories": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "fixture": {
          "type": "object",
          "required": ["projectId", "kind"],
          "additionalProperties": false,
          "properties": {
            "projectId": { "type": "string", "minLength": 1 },
            "kind": { "type": "string", "minLength": 1 },
            "detail": { "type": ["string", "null"] }
          }
        },
        "contentClass": { "enum": ["FACTUAL", "FICTION", "HYBRID"] },
        "platform": { "type": "string", "minLength": 1 },
        "aspectRatio": { "type": "string", "minLength": 1 },
        "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
        "expectedArtifacts": { "type": "array", "items": { "type": "string" } },
        "evaluationProfile": { "type": "string", "minLength": 1 },
        "baselineRef": { "type": ["string", "null"] },
        "status": { "enum": ["DRAFT", "ACTIVE", "RETIRED"] },
        "supersedes": { "type": ["string", "null"] }
      }
    },
    "baselinesDoc": {
      "type": "object",
      "required": ["schemaVersion", "revision", "createdAt", "updatedAt", "baselines", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "baselines": { "type": "object", "additionalProperties": { "$ref": "#/definitions/baseline" } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "baseline": {
      "type": "object",
      "required": ["baselineId", "goldenProjectId", "goldenVersion", "version", "metrics", "createdAt", "reason"],
      "additionalProperties": false,
      "properties": {
        "baselineId": { "type": "string", "pattern": "^base-[0-9a-f]{12}$" },
        "goldenProjectId": { "type": "string", "minLength": 1 },
        "goldenVersion": { "type": "integer", "minimum": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "metrics": { "type": "object", "additionalProperties": { "$ref": "#/definitions/metricValue" } },
        "pipelineVersion": { "type": ["string", "null"] },
        "providerVersions": { "type": "array", "items": { "type": "string" } },
        "promptPolicyVersion": { "type": ["string", "null"] },
        "instructionsVersion": { "type": ["string", "null"] },
        "artifactVersions": { "type": "object" },
        "perf": { "type": ["object", "null"] },
        "cost": { "type": ["object", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "reason": { "type": "string", "minLength": 1 },
        "metricSchemaVersion": { "type": "string" }
      }
    },
    "metricValue": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["MEASURED", "NOT_APPLICABLE", "NOT_MEASURED"] },
        "value": {},
        "reason": { "type": ["string", "null"] },
        "method": { "type": ["string", "null"] },
        "reviewer": { "type": ["string", "null"] },
        "confidence": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "comparisonsDoc": {
      "type": "object",
      "required": ["schemaVersion", "revision", "createdAt", "updatedAt", "comparisons", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "comparisons": { "type": "object", "additionalProperties": { "$ref": "#/definitions/comparison" } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["comparisonId", "goldenProjectId", "baselineVersion", "candidateLabel", "metricResults", "regressions", "improvements", "verdict", "comparedAt"],
      "additionalProperties": false,
      "properties": {
        "comparisonId": { "type": "string", "pattern": "^cmp-[0-9a-f]{12}$" },
        "goldenProjectId": { "type": "string", "minLength": 1 },
        "baselineVersion": { "type": "integer", "minimum": 1 },
        "candidateLabel": { "type": "string", "minLength": 1 },
        "metricResults": { "type": "array" },
        "regressions": { "type": "array" },
        "improvements": { "type": "array" },
        "verdict": { "enum": ["PASS", "REVIEW_REQUIRED", "FAIL", "NOT_COMPARABLE"] },
        "comparedAt": { "type": "string", "format": "date-time" },
        "canaryId": { "type": ["string", "null"] }
      }
    },
    "canariesDoc": {
      "type": "object",
      "required": ["schemaVersion", "revision", "createdAt", "updatedAt", "canaries", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "const": "1.0.0" },
        "revision": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "canaries": { "type": "object", "additionalProperties": { "$ref": "#/definitions/canary" } },
        "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
      }
    },
    "canary": {
      "type": "object",
      "required": ["canaryId", "change", "goldenSubset", "status", "createdAt"],
      "additionalProperties": false,
      "properties": {
        "canaryId": { "type": "string", "pattern": "^can-[0-9a-f]{12}$" },
        "change": { "type": "object" },
        "goldenSubset": { "type": "array", "items": { "type": "string" } },
        "status": { "enum": ["OPEN", "PROMOTE_ALLOWED", "BLOCKED", "REVIEW_REQUIRED", "PROMOTED"] },
        "comparisonIds": { "type": "array", "items": { "type": "string" } },
        "promotedBaselineRef": { "type": ["string", "null"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "decidedAt": { "type": ["string", "null"], "format": "date-time" },
        "costEstimate": { "type": ["object", "null"] }
      }
    }
  }
}
