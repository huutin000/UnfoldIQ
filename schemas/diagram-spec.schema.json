{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "diagram-spec.schema.json",
  "title": "UNFOLDIQ DiagramSpec v1 (data-driven DiagramScene)",
  "description": "Original SVG diagram described as JSON. Numeric fields are a constant or [seconds, value] keyframes (ordering is checked by lib/diagram).",
  "type": "object",
  "required": ["version", "durationSec", "elements"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "durationSec": { "type": "number", "exclusiveMinimum": 0 },
    "background": { "type": "string" },
    "palette": { "type": "object", "additionalProperties": { "type": "string" } },
    "elements": { "type": "array", "items": { "$ref": "#/definitions/element" } }
  },
  "definitions": {
    "track": {
      "oneOf": [
        { "type": "number" },
        { "type": "array", "minItems": 1, "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } } }
      ]
    },
    "show": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "number", "minimum": 0 } },
    "common": {
      "id": { "type": "string", "minLength": 1 },
      "show": { "$ref": "#/definitions/show" },
      "opacity": { "$ref": "#/definitions/track" }
    },
    "element": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["circle", "line", "rect", "path", "text"] },
        "show": { "$ref": "#/definitions/show" },
        "opacity": { "$ref": "#/definitions/track" },
        "stroke": { "type": "string" },
        "strokeWidth": { "$ref": "#/definitions/track" },
        "dash": { "type": "boolean" },
        "draw": { "$ref": "#/definitions/track" },
        "fill": { "type": "string" },
        "cx": { "$ref": "#/definitions/track" }, "cy": { "$ref": "#/definitions/track" }, "r": { "$ref": "#/definitions/track" },
        "x1": { "$ref": "#/definitions/track" }, "y1": { "$ref": "#/definitions/track" }, "x2": { "$ref": "#/definitions/track" }, "y2": { "$ref": "#/definitions/track" },
        "x": { "$ref": "#/definitions/track" }, "y": { "$ref": "#/definitions/track" }, "w": { "$ref": "#/definitions/track" }, "h": { "$ref": "#/definitions/track" },
        "rx": { "type": "number", "minimum": 0 },
        "d": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "anchor": { "enum": ["start", "middle", "end"] },
        "weight": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
