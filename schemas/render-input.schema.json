{
  "$id": "https://unfoldiq.io/schemas/render-input.schema.json",
  "title": "UNFOLDIQ Render Input Contract (STEP-12)",
  "description": "Deterministic render input consumed by both the Node pipeline and the Remotion TSX branch. Canonical ms/frame semantics live in lib/render-time.js.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "platform", "composition", "timeline", "scenes", "assets", "audio", "captions", "visualSystem", "provenance", "status"],
  "definitions": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerId", "kind", "startMs", "endMs"],
      "properties": {
        "layerId": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["IMAGE", "VIDEO", "TEXT", "SHAPE", "BACKGROUND", "GROUP"] },
        "startMs": { "type": "integer", "minimum": 0 },
        "endMs": { "type": "integer", "minimum": 0 },
        "assetId": { "type": "string", "minLength": 1 },
        "fit": { "type": "string", "enum": ["cover", "contain"] },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "xPct": { "type": "number", "minimum": 0, "maximum": 100 },
            "yPct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "scale": { "type": "number", "minimum": 0 },
        "translate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "xPct": { "type": "number" },
            "yPct": { "type": "number" }
          }
        },
        "rotation": { "type": "number" },
        "motion": { "type": "string", "enum": ["NONE", "SLOW_ZOOM_IN", "SLOW_ZOOM_OUT", "PAN_LEFT", "PAN_RIGHT", "PAN_UP", "PAN_DOWN", "CUSTOM"] },
        "text": { "type": "string" },
        "widthPct": { "type": "number", "minimum": 0, "maximum": 100 },
        "align": { "type": "string", "enum": ["left", "center", "right"] },
        "typographyToken": { "type": "string" },
        "fontSize": { "type": "number", "minimum": 1 },
        "weight": { "type": ["string", "number"] },
        "lineHeight": { "type": "number", "minimum": 0 },
        "color": { "type": "string" },
        "enter": { "type": "string" },
        "exit": { "type": "string" },
        "shape": { "type": "string", "enum": ["rect", "circle", "line"] },
        "fill": { "type": "object" },
        "xPct": { "type": "number" },
        "yPct": { "type": "number" },
        "wPct": { "type": "number", "minimum": 0 },
        "hPct": { "type": "number", "minimum": 0 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "trimStartMs": { "type": "integer", "minimum": 0 },
        "trimEndMs": { "type": "integer", "minimum": 0 },
        "muted": { "type": "boolean" },
        "audioPolicy": { "type": "string", "enum": ["MUTED", "USE_AS_PLANNED"] },
        "playbackRate": { "type": "number", "minimum": 0.9, "maximum": 1.1 },
        "loop": { "type": "boolean" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/layer" }
        },
        "purpose": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "IMAGE" } } },
          "then": { "required": ["assetId", "fit"] }
        },
        {
          "if": { "properties": { "kind": { "const": "VIDEO" } } },
          "then": { "required": ["assetId", "fit"] }
        },
        {
          "if": { "properties": { "kind": { "const": "TEXT" } } },
          "then": { "required": ["text"] }
        },
        {
          "if": { "properties": { "kind": { "const": "SHAPE" } } },
          "then": { "required": ["shape", "fill"] }
        },
        {
          "if": { "properties": { "kind": { "const": "BACKGROUND" } } },
          "then": { "required": ["fill"] }
        },
        {
          "if": { "properties": { "kind": { "const": "GROUP" } } },
          "then": { "required": ["children"] }
        }
      ]
    },
    "audioClip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipId", "path", "fromMs", "trimStartMs", "trimEndMs", "gainDb", "fadeInMs", "fadeOutMs", "loop"],
      "properties": {
        "clipId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "fromMs": { "type": "integer", "minimum": 0 },
        "trimStartMs": { "type": "integer", "minimum": 0 },
        "trimEndMs": { "type": "integer", "minimum": 0 },
        "gainDb": { "type": "number", "minimum": -60, "maximum": 12 },
        "fadeInMs": { "type": "integer", "minimum": 0 },
        "fadeOutMs": { "type": "integer", "minimum": 0 },
        "loop": { "type": "boolean" },
        "durationMs": { "type": "number", "minimum": 0 },
        "unstaged": { "type": "boolean" },
        "ducking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "targetAudioId": { "type": "string" },
            "reductionDb": { "type": "number" },
            "ranges": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["startMs", "endMs"],
                "properties": {
                  "startMs": { "type": "integer", "minimum": 0 },
                  "endMs": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["youtube", "tiktok"] },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "fps", "durationMs", "durationInFrames", "background", "outputName"],
      "properties": {
        "id": { "type": "string", "const": "UNFOLDIQVideo" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "durationInFrames": { "type": "integer", "minimum": 0 },
        "background": { "type": "string", "minLength": 1 },
        "outputName": { "type": "string", "minLength": 1 }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actualTimelineEndMs", "sources"],
      "properties": {
        "actualTimelineEndMs": { "type": "integer", "minimum": 0 },
        "sources": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "startMs", "endMs", "durationMs", "background", "layers", "transition"],
        "properties": {
          "sceneId": { "type": "string", "minLength": 1 },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 0 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "background": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string" },
          "overlapMs": { "type": "integer", "minimum": 0 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/layer" }
          },
          "transition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "type": "string", "enum": ["CUT", "FADE", "SLIDE"] },
              "durationMs": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "type", "stagedPath", "staticFilePath"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["image", "video", "audio"] },
          "stagedPath": { "type": "string", "minLength": 1 },
          "staticFilePath": { "type": "string", "minLength": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "durationMs": { "type": "integer", "minimum": 0 },
          "unstaged": { "type": "boolean" }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "music", "sfx", "generatedClipAudioPolicy"],
      "properties": {
        "voice": { "type": "array", "items": { "$ref": "#/definitions/audioClip" } },
        "music": { "type": "array", "items": { "$ref": "#/definitions/audioClip" } },
        "sfx": { "type": "array", "items": { "$ref": "#/definitions/audioClip" } },
        "generatedClipAudioPolicy": { "type": "string", "enum": ["MUTE_GENERATED_CLIP_AUDIO", "USE_AS_PLANNED", "MIX", "REPLACE"] }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "items"],
      "properties": {
        "mode": { "type": "string", "enum": ["NONE", "SIDECAR", "BURNED_IN", "BOTH"] },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["captionId", "startMs", "endMs", "text"],
            "properties": {
              "captionId": { "type": "string", "minLength": 1 },
              "startMs": { "type": "integer", "minimum": 0 },
              "endMs": { "type": "integer", "minimum": 0 },
              "text": { "type": "string", "minLength": 1 },
              "sceneId": { "type": "string" },
              "words": { "type": "array", "items": { "type": "object" } }
            }
          }
        },
        "safeZone": { "type": "object" },
        "styleGroup": { "type": "string" }
      }
    },
    "visualSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "foreground", "muted", "accent", "fontFamily", "titleSize", "bodySize", "captionSize", "cornerRadius", "spacing", "overlayOpacity"],
      "properties": {
        "background": { "type": "string", "minLength": 1 },
        "foreground": { "type": "string", "minLength": 1 },
        "muted": { "type": "string", "minLength": 1 },
        "accent": { "type": "string", "minLength": 1 },
        "fontFamily": { "type": "string", "minLength": 1 },
        "titleSize": { "type": "number", "minimum": 1 },
        "bodySize": { "type": "number", "minimum": 1 },
        "captionSize": { "type": "number", "minimum": 1 },
        "cornerRadius": { "type": "number", "minimum": 0 },
        "spacing": { "type": "number", "minimum": 0 },
        "overlayOpacity": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflightVersion", "timelineHash", "assetManifestHash", "audioMixHash", "captionsHash", "visualBibleVersion", "continuityRegistryVersion", "durationContractVersion", "platformProfileVersion", "remotionVersions"],
      "properties": {
        "preflightVersion": { "type": "string" },
        "timelineHash": { "type": "string" },
        "assetManifestHash": { "type": "string" },
        "audioMixHash": { "type": "string" },
        "captionsHash": { "type": "string" },
        "visualBibleVersion": { "type": "string" },
        "continuityRegistryVersion": { "type": "string" },
        "durationContractVersion": { "type": "string" },
        "platformProfileVersion": { "type": "string" },
        "remotionVersions": { "type": "object" }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    },
    "status": { "type": "string", "enum": ["READY", "REVIEW_REQUIRED", "BLOCKED"] }
  }
}
