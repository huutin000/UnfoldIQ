{
  "$id": "https://unfoldiq.io/schemas/render-plan.schema.json",
  "title": "UNFOLDIQ Render Plan Contract (STEP-12)",
  "description": "Frame-quantized render plan derived from a render input. Frame ranges are end-exclusive: the final scene endFrame must equal composition durationInFrames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "platform", "generatedAt", "composition", "scenes", "audioTracks", "captionTrack", "assetMap", "styleTokens", "validation", "planHash", "status"],
  "definitions": {
    "frameRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startFrame", "endFrame"],
      "properties": {
        "startFrame": { "type": "integer", "minimum": 0 },
        "endFrame": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "enum": ["youtube", "tiktok"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "fps", "durationMs", "durationInFrames", "background", "outputName"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
        "durationMs": { "type": "integer", "minimum": 0 },
        "durationInFrames": { "type": "integer", "minimum": 0 },
        "background": { "type": "string", "minLength": 1 },
        "outputName": { "type": "string", "minLength": 1 }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sceneId", "startFrame", "endFrame", "layers"],
        "properties": {
          "sceneId": { "type": "string", "minLength": 1 },
          "startFrame": { "type": "integer", "minimum": 0 },
          "endFrame": { "type": "integer", "minimum": 0 },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["layerId", "kind", "startFrame", "endFrame"],
              "properties": {
                "layerId": { "type": "string", "minLength": 1 },
                "kind": { "type": "string", "enum": ["IMAGE", "VIDEO", "TEXT", "SHAPE", "BACKGROUND", "GROUP"] },
                "startFrame": { "type": "integer", "minimum": 0 },
                "endFrame": { "type": "integer", "minimum": 0 },
                "assetStaticPath": { "type": "string" },
                "text": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "audioTracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["voice", "music", "sfx"],
      "properties": {
        "voice": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clipId", "startFrame", "endFrame"],
            "properties": {
              "clipId": { "type": "string", "minLength": 1 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 0 },
              "path": { "type": "string" }
            }
          }
        },
        "music": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clipId", "startFrame", "endFrame"],
            "properties": {
              "clipId": { "type": "string", "minLength": 1 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 0 },
              "path": { "type": "string" }
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["clipId", "startFrame", "endFrame"],
            "properties": {
              "clipId": { "type": "string", "minLength": 1 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 0 },
              "path": { "type": "string" }
            }
          }
        }
      }
    },
    "captionTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "frames"],
      "properties": {
        "mode": { "type": "string", "enum": ["NONE", "SIDECAR", "BURNED_IN", "BOTH"] },
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["captionId", "startFrame", "endFrame"],
            "properties": {
              "captionId": { "type": "string", "minLength": 1 },
              "startFrame": { "type": "integer", "minimum": 0 },
              "endFrame": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "assetMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "stagedPath", "staticFilePath"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "sourcePath": { "type": "string" },
          "stagedPath": { "type": "string", "minLength": 1 },
          "staticFilePath": { "type": "string", "minLength": 1 },
          "unstaged": { "type": "boolean" }
        }
      }
    },
    "styleTokens": { "type": "object" },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflightStatus", "timelineStatus", "checks"],
      "properties": {
        "preflightStatus": { "type": "string" },
        "timelineStatus": { "type": "string" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string" },
              "status": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        }
      }
    },
    "planHash": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["READY", "REVIEW_REQUIRED", "BLOCKED"] }
  }
}
