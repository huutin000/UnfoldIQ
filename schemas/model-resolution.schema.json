{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "model-resolution.schema.json",
  "title": "UNFOLDIQ Provider/Model Resolution Artifact (1G.6)",
  "description": "Downstream model selection for one 1G.5 render requirement. Never rewrites visual truth; never executes generation.",
  "type": "object",
  "required": ["version", "resolutionId", "projectId", "shotId", "renderMode", "requiredCapabilities", "registrySnapshotRef", "selectionReasons", "fingerprint", "status"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "resolutionId": { "type": "string", "pattern": "^mr-[0-9a-f]{12}$" },
    "schemaVersion": { "type": "string" },
    "resolverVersion": { "type": "string" },
    "policyVersion": { "type": ["string", "null"] },
    "projectId": { "type": ["string", "null"] },
    "sceneId": { "type": ["string", "null"] },
    "shotId": { "type": "string" },
    "sourceDecisionId": { "type": ["string", "null"] },
    "sourceDecisionFingerprint": { "type": ["string", "null"] },
    "requirementFingerprint": { "type": ["string", "null"] },
    "requirement": { "type": "object" },
    "renderMode": { "enum": ["STATIC_IMAGE", "REMOTION_MOTION", "VEO_FIRST_FRAME", "VEO_FIRST_LAST", "VEO_REFERENCE", null] },
    "requiredCapabilities": { "type": "array", "items": { "type": "string" } },
    "registrySnapshotRef": {
      "type": "object",
      "required": ["snapshotId", "fingerprint"],
      "properties": {
        "snapshotId": { "type": "string" },
        "fingerprint": { "type": "string" }
      }
    },
    "candidateModels": { "type": "array" },
    "rejectedModels": { "type": "array" },
    "recommendedProvider": { "type": ["string", "null"] },
    "recommendedModel": { "type": ["string", "null"] },
    "selectedProvider": { "type": ["string", "null"] },
    "selectedModel": { "type": ["string", "null"] },
    "effectiveProvider": { "type": ["string", "null"] },
    "effectiveModel": { "type": ["string", "null"] },
    "selectionState": { "type": ["string", "null"] },
    "selectionReasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "availabilityState": { "type": ["string", "null"] },
    "capabilityFreshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
    "availabilityFreshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
    "costFreshness": { "enum": ["FRESH", "STALE", "UNKNOWN"] },
    "costEstimate": { "type": "object" },
    "resolutionKind": { "enum": ["ASSET_SATISFIED", "RENDERER_NOT_REQUIRED", "ASSET_MODEL", "VIDEO_MODEL"] },
    "replanSuggestion": { "type": ["string", "null"] },
    "overrideReason": { "type": ["string", "null"] },
    "sourceRefs": { "type": "array", "items": { "type": "string" } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "status": { "enum": ["RESOLVED", "PROVISIONAL", "REVIEW_REQUIRED", "BLOCKED", "NOT_REQUIRED"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
