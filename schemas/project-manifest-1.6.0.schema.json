{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project-manifest-1.6.0.schema.json",
  "title": "UNFOLDIQ Versioned Project Manifest (Phase 2.4-2.6: schema 1.6.0 adds narration audio, speech-rate QA, performance QA, dialogue routing refs)",
  "description": "Durable, machine-readable state contract. 1.6.0 is 1.5.0 plus four narration/QA artifact slots. The Manifest stays an INDEX: it never carries audio bytes, transcripts, F0 arrays or QA bodies. finalAudioVersion remains RESERVED for the Phase 2.8 post-mix master.",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "projectId",
    "projectVersion",
    "revision",
    "createdAt",
    "updatedAt",
    "artifacts",
    "providers",
    "state",
    "history",
    "recovery",
    "governance",
    "lineage",
    "fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.6.0"
    },
    "manifestId": {
      "type": "string",
      "pattern": "^pm-[0-9a-f]{12}$"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "projectVersion": {
      "type": "integer",
      "minimum": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pipelineVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creativeBriefVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "channelBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "storyBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "characterBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "worldBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "visualBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "researchPackVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "finalSpokenScriptVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "voiceBibleVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "shotPlanVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "promptCompilerVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "agentInstructionsVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "assetRegistryVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "finalAudioVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "alignmentVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "timelineVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "renderVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "narrationDirectionVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "pronunciationProfileVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "pronunciationRuntimePassVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "ttsReadyPlanVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "narrationAudioVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "speechRateQaVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "performanceQaVersion": {
          "$ref": "#/definitions/artifactRef"
        },
        "dialogueRoutingVersion": {
          "$ref": "#/definitions/artifactRef"
        }
      }
    },
    "providers": {
      "type": "object",
      "required": [
        "selections"
      ],
      "additionalProperties": false,
      "properties": {
        "registryVersion": {
          "anyOf": [
            {
              "$ref": "#/definitions/artifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "modelId"
            ],
            "additionalProperties": false,
            "properties": {
              "modelId": {
                "type": "string",
                "minLength": 1
              },
              "providerId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "resolutionRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "DRAFT",
            "ACTIVE",
            "READY",
            "COMPLETE",
            "BLOCKED"
          ]
        }
      }
    },
    "history": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "historySchemaVersion",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "historySchemaVersion": {
          "const": "1.0.0"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "recovery": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "recoverySchemaVersion",
        "dagSchemaVersion",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "recoverySchemaVersion": {
          "const": "1.0.0"
        },
        "dagSchemaVersion": {
          "const": "1.0.0"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "governance": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "provenanceSchemaVersion",
        "complianceSchemaVersion",
        "storageSchemaVersion",
        "ref"
      ],
      "additionalProperties": false,
      "properties": {
        "provenanceSchemaVersion": {
          "const": "1.0.0"
        },
        "complianceSchemaVersion": {
          "const": "1.0.0"
        },
        "storageSchemaVersion": {
          "const": "1.0.0"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previousManifestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "previousProjectVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  },
  "definitions": {
    "artifactRef": {
      "type": "object",
      "required": [
        "version",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "status": {
          "enum": [
            "VERIFIED",
            "MIGRATED",
            "UNRESOLVED",
            "NOT_CREATED_YET"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
