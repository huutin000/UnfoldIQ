{
  "$id": "https://unfoldiq.io/schemas/final-artifact.schema.json",
  "title": "UNFOLDIQ Final Artifact Contract (STEP-13)",
  "description": "Accepted final render artifact with provenance and QA linkage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "projectId", "acceptedAttemptId", "outputPath", "sizeBytes", "checksum", "durationMs", "width", "height", "fps", "codec", "audio", "captions", "renderPlanHash", "inputFingerprint", "qaStatus", "generatedAt", "provenance"],
  "properties": {
    "version": { "type": "string", "const": "1.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "acceptedAttemptId": { "type": "string", "minLength": 1 },
    "outputPath": { "type": "string", "minLength": 1 },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "durationMs": { "type": "number", "minimum": 0 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "integer", "minimum": 1, "maximum": 120 },
    "codec": { "type": "string", "minLength": 1 },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "streams": { "type": "integer", "minimum": 0 }
      }
    },
    "captions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sidecarPath": { "type": "string" }
      }
    },
    "renderPlanHash": { "type": "string", "minLength": 1 },
    "inputFingerprint": { "type": "object" },
    "qaStatus": { "type": "string", "minLength": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformProfileVersion", "remotionVersions"],
      "properties": {
        "platformProfileVersion": { "type": "string" },
        "remotionVersions": { "type": "object" }
      }
    }
  }
}
