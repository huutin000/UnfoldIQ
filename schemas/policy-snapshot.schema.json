{
  "$id": "https://unfoldiq.io/schemas/policy-snapshot.schema.json",
  "title": "UNFOLDIQ Policy Snapshot Contract",
  "description": "Normalized policy state plus source metadata for one platform",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "snapshotId",
    "platform",
    "categories",
    "verifiedAt",
    "verificationStatus",
    "sourceRefs",
    "normalizedRulesVersion",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verificationStatus": {
      "type": "string",
      "enum": ["LIVE_VERIFIED", "SNAPSHOT_ONLY", "NOT_VERIFIED"]
    },
    "observedUpdateDate": {
      "type": "string",
      "format": "date-time"
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "normalizedRulesVersion": {
      "type": "string",
      "minLength": 1
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "axis", "category", "summary", "decisionLogic", "sourceIds"],
        "properties": {
          "ruleId": { "type": "string", "minLength": 1 },
          "axis": {
            "type": "string",
            "enum": ["PLATFORM_ALLOWEDNESS", "RIGHTS", "AI_TRANSPARENCY", "MONETIZATION_AD_SUITABILITY"]
          },
          "category": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "decisionLogic": { "type": "string", "minLength": 1 },
          "effectiveDate": { "type": "string", "format": "date-time" },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
