{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evidence-fidelity-decision.schema.json",
  "title": "UNFOLDIQ Evidence Fidelity Decision (FIX PRE-2.4, schema 1.0.0)",
  "description": "Versioned, machine-readable source-to-candidate fidelity decision. Blocking gate: a candidate with CHANGED_INVALID or unresolved REVIEW_REQUIRED protected items can never reach a canonical Final Spoken Script. REVIEW_REQUIRED is never coerced into PASS.",
  "type": "object",
  "required": ["schemaVersion", "decisionId", "version", "projectId", "contentMode", "contentClass", "sourceScriptRef", "humanizationRef", "checks", "issues", "decision", "provenance", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "decisionId": { "type": "string", "pattern": "^fid-[0-9a-f]{12}$" },
    "version": { "type": "integer", "minimum": 1 },
    "projectId": { "type": "string", "minLength": 1 },
    "contentMode": { "type": "string", "minLength": 1 },
    "contentClass": { "enum": ["FACTUAL", "FICTION", "HYBRID"] },
    "sourceScriptRef": {
      "type": "object",
      "required": ["artifact", "version"],
      "additionalProperties": false,
      "properties": {
        "artifact": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "humanizationRef": { "type": "string", "pattern": "^hum-[0-9a-f]{12}$" },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/definitions/fidelityCheck" }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "minLength": 3 },
          "segmentId": { "type": ["string", "null"] },
          "detail": { "type": ["string", "null"], "maxLength": 500 },
          "evidenceRef": { "type": ["string", "null"] }
        }
      }
    },
    "decision": { "enum": ["PASS", "REVIEW_REQUIRED", "FAIL"] },
    "provenance": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "createdAt": { "type": ["string", "null"] },
        "evidenceRefs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  },
  "definitions": {
    "fidelityCheck": {
      "type": "object",
      "required": ["checkId", "segmentId", "protectedItemType", "status"],
      "additionalProperties": false,
      "properties": {
        "checkId": { "type": "string", "minLength": 1 },
        "segmentId": { "type": "string", "minLength": 1 },
        "protectedItemType": { "enum": ["FACT", "NUMBER", "DATE", "NAME", "QUOTE", "CAVEAT", "UNCERTAINTY", "CLASSIFICATION", "NEGATION", "COMPARISON", "CAUSALITY", "TEMPORAL_ORDER", "ATTRIBUTION", "SCOPE"] },
        "sourceValue": { "type": ["string", "null"] },
        "candidateValue": { "type": ["string", "null"] },
        "status": { "enum": ["PRESERVED", "ALLOWED_REPHRASE", "REVIEW_REQUIRED", "CHANGED_INVALID", "NOT_APPLICABLE"] },
        "reason": { "type": ["string", "null"], "maxLength": 500 },
        "evidenceRef": { "type": ["string", "null"] }
      }
    }
  }
}
