{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "voice-license-evidence.schema.json",
  "title": "UNFOLDIQ Voice/Model License Evidence (Phase 2.1 FIX 01)",
  "description": "Canonical, traceable license evidence for a TTS provider/model. Evidence is recorded from an OFFICIAL source with a URL and retrieval timestamp. Never a bare `licensed=true`: MODEL_LICENSE, VOICE_ASSET_RIGHTS and OUTPUT_USAGE_STATUS are separate claims that may resolve differently. A claim that cannot be proven from an official source stays REVIEW_REQUIRED — it is never inferred upward.",
  "type": "object",
  "required": ["schemaVersion", "evidenceId", "provider", "model", "retrievedAt", "officialSource", "claims", "fingerprint"],
  "additionalProperties": false,
  "properties": {
    "rightsDecision": { "$ref": "#/definitions/rightsDecision" },
    "schemaVersion": { "const": "1.0.0" },
    "evidenceId": { "type": "string", "pattern": "^lice-[0-9a-f]{12}$" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "officialSource": {
      "type": "object",
      "description": "Only official upstream sources are acceptable evidence.",
      "required": ["publisher", "url"],
      "additionalProperties": false,
      "properties": {
        "publisher": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "licenseFileUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "modelCardUrl": { "type": ["string", "null"], "pattern": "^https://" },
        "quotedStatement": {
          "type": ["string", "null"],
          "description": "Verbatim text from the official source that supports the claim. No paraphrase presented as a quote."
        }
      }
    },
    "upstreamArtifact": {
      "type": ["object", "null"],
      "description": "Upstream identity of the artifact, when the official source publishes one.",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "release": { "type": ["string", "null"] },
        "releaseDate": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "languageCount": { "type": ["integer", "null"], "minimum": 0 },
        "voiceCount": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "runtimeBinding": {
      "type": ["object", "null"],
      "description": "How the repo's runtime maps onto the upstream artifact. A repo-internal model label is NOT an upstream pin: this is where that gap is recorded honestly.",
      "additionalProperties": false,
      "properties": {
        "runtimeLabel": { "type": ["string", "null"] },
        "upstreamReleasePinned": { "type": "boolean" },
        "installed": { "type": "boolean" },
        "installRequirement": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "runtimeVoiceInventory": {
      "type": ["array", "null"],
      "description": "Voices the INSTALLED runtime can actually resolve, as discovered from the runtime itself (never from documentation, never from a fallback table). Persisted so voice-identity validation is stable in a fresh process without re-probing or an env override.",
      "items": {
        "type": "object",
        "required": ["voiceId", "language"],
        "additionalProperties": false,
        "properties": {
          "voiceId": { "type": "string", "minLength": 1 },
          "language": { "type": "string", "minLength": 2 },
          "runtimeVerified": { "type": "boolean" }
        }
      }
    },
    "claims": {
      "type": "object",
      "description": "Three separate rights claims. They may legitimately differ.",
      "required": ["modelLicense", "voiceAssetRights", "outputUsageStatus"],
      "additionalProperties": false,
      "properties": {
        "modelLicense": { "$ref": "#/definitions/claim" },
        "voiceAssetRights": { "$ref": "#/definitions/claim" },
        "outputUsageStatus": { "$ref": "#/definitions/claim" }
      }
    },
    "trainingDataDisclosure": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "required": ["name", "license"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"], "pattern": "^https://" }
        }
      }
    },
    "notAsserted": {
      "type": ["array", "null"],
      "description": "Explicit list of rights that the official source does NOT state, so nobody later reads silence as permission.",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
  },
  "definitions": {
    "rightsDecision": {
      "type": "object",
      "required": ["decision", "decisionAt", "scope", "evidenceRefs", "residualRisks", "reviewTriggers"],
      "additionalProperties": false,
      "properties": {
        "decision": { "enum": ["ACCEPT_RESIDUAL_RIGHTS_RISK", "STRICT_VERIFICATION"] },
        "decisionAt": { "type": "string", "format": "date-time" },
        "decidedBy": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "object",
          "required": ["provider", "model", "voiceId", "use", "noVoiceCloning", "noImpersonation"],
          "additionalProperties": false,
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "model": { "type": "string", "minLength": 1 },
            "voiceId": { "type": "string", "minLength": 1 },
            "use": { "type": "string", "minLength": 1 },
            "noVoiceCloning": { "const": true },
            "noImpersonation": { "const": true }
          }
        },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "residualRisks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reviewTriggers": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "claim": {
      "type": "object",
      "required": ["status", "licenseIdentifier"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["VERIFIED", "REVIEW_REQUIRED", "RISK_ACCEPTED", "UNRESOLVED", "NOT_APPLICABLE"],
          "description": "VERIFIED requires an official source that states this exact claim. Never promote a weaker claim to VERIFIED. RISK_ACCEPTED requires an explicit, versioned operator rightsDecision recorded in this document — never inferred."
        },
        "licenseIdentifier": { "type": ["string", "null"] },
        "scope": { "type": ["string", "null"] },
        "basis": { "type": ["string", "null"] },
        "retrievedAt": { "type": ["string", "null"], "format": "date-time" },
        "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}