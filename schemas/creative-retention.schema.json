{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creative-retention.schema.json",
  "title": "Phase 6A Creative Retention artifacts",
  "description": "CreativeFinding, CreativeFingerprint and report envelopes. Pre-publish CREATIVE_RETENTION_RISK is not ACTUAL_RETENTION: no retention/watch-time numbers exist in this contract.",
  "definitions": {
    "creativeFinding": {
      "type": "object",
      "required": ["findingId", "code", "severity", "scope", "reason", "reasonClass", "evidenceRefs", "correctiveAction", "repairClass", "confidence", "status", "source"],
      "additionalProperties": false,
      "properties": {
        "findingId": { "type": "string", "pattern": "^cf-[0-9a-f]{16}$" },
        "code": { "type": "string", "minLength": 3 },
        "severity": { "enum": ["P0", "P1", "P2", "P3"] },
        "scope": { "enum": ["HOOK", "BEAT", "SCENE", "SHOT", "AUDIO", "CAPTION", "PACKAGING", "GLOBAL"] },
        "startMs": { "type": "number", "minimum": 0 },
        "endMs": { "type": "number", "minimum": 0 },
        "beatId": { "type": "string" },
        "sceneId": { "type": "string" },
        "shotId": { "type": "string" },
        "reason": { "type": "string", "minLength": 1 },
        "reasonClass": { "type": "string", "minLength": 1 },
        "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "correctiveAction": { "type": "string", "minLength": 1 },
        "repairClass": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "status": { "enum": ["OPEN", "REPAIRED", "ACCEPTED_INTENTIONAL", "REVIEW_REQUIRED"] },
        "relatedFindingIds": { "type": "array", "items": { "type": "string" } },
        "checkpoints": { "type": "array", "items": { "type": "string" } },
        "statusReason": { "type": "string" },
        "source": { "enum": ["DETERMINISTIC", "MODEL"] }
      }
    },
    "creativeFingerprint": {
      "type": "object",
      "required": ["kind", "version", "projectId", "inputFingerprint", "shotDurationsMs", "modalitySequence", "framingSequence", "motionPrimitiveSequence", "transitionSequence", "motionIntensityTimeline", "narrativeEnergyTimeline", "visualRestRanges", "metrics", "anchors", "fingerprintHash"],
      "properties": {
        "kind": { "const": "CREATIVE_FINGERPRINT" },
        "shotDurationsMs": { "type": "array", "items": { "type": "number" } },
        "modalitySequence": { "type": "array", "items": { "type": "string" } },
        "framingSequence": { "type": "array", "items": { "type": "string" } },
        "motionPrimitiveSequence": { "type": "array", "items": { "type": "string" } },
        "transitionSequence": { "type": "array", "items": { "type": "string" } },
        "motionIntensityTimeline": { "type": "array", "items": { "type": "object" } },
        "narrativeEnergyTimeline": { "type": "array", "items": { "type": "object" } },
        "musicEnergyTimeline": { "type": "array", "items": { "type": "object" } },
        "visualRestRanges": { "type": "array", "items": { "type": "object" } },
        "metrics": { "type": "object", "additionalProperties": { "type": ["number", "string"] } },
        "anchors": {
          "type": "object",
          "required": ["hookCheckpointIds", "beatIds", "sceneIds", "shotIds"],
          "properties": {
            "hookCheckpointIds": { "type": "array", "items": { "type": "string" } },
            "beatIds": { "type": "array", "items": { "type": "string" } },
            "sceneIds": { "type": "array", "items": { "type": "string" } },
            "shotIds": { "type": "array", "items": { "type": "string" } }
          }
        },
        "fingerprintHash": { "type": "string" }
      }
    },
    "creativeRetentionRiskReport": {
      "type": "object",
      "required": ["kind", "assessmentKind", "actualRetentionStatus", "actualRetention", "riskLevel", "openFindingCounts", "drivers", "analyticsAnchors"],
      "properties": {
        "kind": { "const": "CREATIVE_RETENTION_RISK" },
        "assessmentKind": { "const": "PRE_PUBLISH_CREATIVE_RETENTION_RISK" },
        "actualRetentionStatus": { "const": "NOT_AVAILABLE_PRE_PUBLISH" },
        "actualRetention": { "type": "null" },
        "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "REVIEW_REQUIRED"] },
        "openFindingCounts": {
          "type": "object",
          "required": ["P0", "P1", "P2", "P3"],
          "properties": { "P0": { "type": "integer" }, "P1": { "type": "integer" }, "P2": { "type": "integer" }, "P3": { "type": "integer" } }
        },
        "drivers": { "type": "array", "items": { "type": "object", "required": ["findingId", "code", "severity"] } },
        "analyticsAnchors": { "type": "object" }
      }
    },
    "multimodalWatchReport": {
      "type": "object",
      "required": ["kind", "mode", "channelsEvaluated", "video", "reviewer", "segments", "coverage", "blockers", "verdict", "findings"],
      "properties": {
        "kind": { "const": "MULTIMODAL_WATCH" },
        "mode": { "enum": ["FULL_WATCH", "SEGMENT_REWATCH"] },
        "verdict": { "enum": ["PASS", "FAIL", "REVIEW_REQUIRED"] },
        "channelsEvaluated": { "type": "array", "items": { "type": "string" } },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "findings": { "type": "array", "items": { "$ref": "#/definitions/creativeFinding" } }
      }
    }
  }
}
