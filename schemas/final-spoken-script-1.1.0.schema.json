{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "final-spoken-script-1.1.0.schema.json",
  "title": "UNFOLDIQ Final Spoken Script (canonical lineage, schema 1.1.0)",
  "description": "1.1.0 extends the Phase-2 identity contract with the humanization lineage required by FIX PRE-2.4: provenance carries sourceScriptRef, humanizationRef, evidenceFidelityRef, naturalnessQaRef. productionScriptStatus = CANONICAL only after both gates PASS. The text stays CLEAN: no SSML, no provider markup, no pronunciation substitutions. 1.0.0 documents remain loadable.",
  "type": "object",
  "required": [
    "schemaVersion",
    "scriptArtifactId",
    "scriptVersion",
    "projectId",
    "language",
    "segments",
    "fingerprint"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "scriptArtifactId": {
      "type": "string",
      "pattern": "^fss-[0-9a-z][0-9a-z-]{2,62}$"
    },
    "scriptVersion": {
      "type": "integer",
      "minimum": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16
    },
    "contentMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "contentClass": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "FACTUAL",
        "FICTION",
        "HYBRID"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/spokenSegment"
      }
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "productionScriptStatus": {
          "enum": [
            "NOT_APPLICABLE",
            "CANONICAL",
            "PENDING"
          ],
          "description": "NOT_APPLICABLE = bounded validation fixture, no canonical production script exists."
        },
        "sourceScriptRef": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "artifact",
            "version"
          ],
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "humanizationRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^hum-[0-9a-f]{12}$"
        },
        "evidenceFidelityRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fid-[0-9a-f]{12}$"
        },
        "naturalnessQaRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^nqa-[0-9a-f]{12}$"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    }
  },
  "definitions": {
    "spokenSegment": {
      "type": "object",
      "required": [
        "segmentId",
        "ordinal",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "segmentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "beatRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
