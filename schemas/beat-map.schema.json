{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "beat-map.schema.json",
  "title": "UNFOLDIQ Story Beat Map (1G.3)",
  "type": "object",
  "required": ["version", "beatMapId", "projectId", "contentClass", "sourceStoryDraftRef", "beats", "fingerprint", "status"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "beatMapId": { "type": "string", "pattern": "^bm-[0-9a-f]{12}$" },
    "projectId": { "type": "string" },
    "platform": { "enum": ["youtube", "tiktok", null] },
    "contentClass": { "enum": ["FACTUAL", "FICTION", "HYBRID"] },
    "sourceStoryDraftRef": {
      "type": "object", "additionalProperties": false,
      "properties": { "draftId": { "type": "string" }, "fingerprint": { "type": ["string", "null"] } }
    },
    "sourceNarrativeBriefRef": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": { "briefId": { "type": "string" } }
    },
    "beats": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["beatId", "order", "storySectionRef", "narrativeRole", "summary"],
        "additionalProperties": false,
        "properties": {
          "beatId": { "type": "string", "pattern": "^bt-[0-9a-f]{12}$" },
          "order": { "type": "integer", "minimum": 0 },
          "storySectionRef": { "type": "string" },
          "narrativeRole": { "enum": ["QUESTION", "SETUP", "EXPLANATION", "EVIDENCE", "REVEAL", "CONTRAST", "RESOLUTION", "REFLECTION"] },
          "summary": { "type": "string", "maxLength": 240 },
          "claimRefs": { "type": "array", "items": { "type": "string" } },
          "classificationRefs": { "type": "array" },
          "importance": { "enum": ["high", "normal", "low"] },
          "visualNeed": { "enum": ["CLAIM_EVIDENCE", "MOTION", "CONTEXT", "STILL"] },
          "continuityHints": { "type": "array", "items": { "type": "string" } },
          "textHash": { "type": "string", "pattern": "^[0-9a-f]{16}$" }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "status": { "enum": ["GENERATED", "REVIEWED", "APPROVED", "STALE"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
