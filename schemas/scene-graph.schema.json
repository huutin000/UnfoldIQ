{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "scene-graph.schema.json",
  "title": "UNFOLDIQ Scene Graph (1G.3)",
  "type": "object",
  "required": ["version", "sceneGraphId", "projectId", "contentClass", "sourceBeatMapRef", "sourceStoryDraftRef", "scenes", "fingerprint", "status"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0.0" },
    "sceneGraphId": { "type": "string", "pattern": "^sg-[0-9a-f]{12}$" },
    "projectId": { "type": "string" },
    "platform": { "enum": ["youtube", "tiktok", null] },
    "contentClass": { "enum": ["FACTUAL", "FICTION", "HYBRID"] },
    "sourceBeatMapRef": {
      "type": "object", "additionalProperties": false,
      "properties": { "beatMapId": { "type": "string" }, "fingerprint": { "type": ["string", "null"] } }
    },
    "sourceStoryDraftRef": {
      "type": "object", "additionalProperties": false,
      "properties": { "draftId": { "type": "string" }, "fingerprint": { "type": ["string", "null"] } }
    },
    "scenes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sceneId", "order", "beatIds", "storySectionRefs", "narrativePurpose", "visualObjective"],
        "additionalProperties": false,
        "properties": {
          "sceneId": { "type": "string", "pattern": "^sc-[0-9a-f]{12}$" },
          "order": { "type": "integer", "minimum": 0 },
          "beatIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "storySectionRefs": { "type": "array", "items": { "type": "string" } },
          "claimRefs": { "type": "array", "items": { "type": "string" } },
          "narrativePurpose": { "type": "string", "maxLength": 240 },
          "visualObjective": { "enum": ["ORIENT", "EXPLAIN", "SHIFT", "RESOLVE"] },
          "subjectRefs": { "type": "array", "items": { "type": "string" } },
          "environmentRefs": { "type": "array", "items": { "type": "string" } },
          "continuityGroup": { "type": "string" },
          "stateBefore": { "type": ["string", "null"] },
          "stateAfter": { "type": ["string", "null"] },
          "transitionReason": { "type": ["string", "null"], "maxLength": 240 },
          "constraints": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object", "required": ["from", "to", "type"], "additionalProperties": false,
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "type": { "enum": ["SEQUENCE", "CONTINUITY", "CAUSE_EFFECT", "CONTRAST", "REVEAL", "RETURN_CALLBACK", "LOCATION_TRANSITION", "TIME_TRANSITION"] }
        }
      }
    },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "status": { "enum": ["GENERATED", "REVIEWED", "APPROVED", "STALE"] },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
