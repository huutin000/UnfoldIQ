{
  "kind": "QUALITY_RUBRIC",
  "rubricVersion": "1.0.0",
  "policyVersion": "1.0.0",
  "scale": {
    "type": "ORDINAL_0_4",
    "anchors": {
      "0": "critical weakness",
      "1": "weak",
      "2": "adequate",
      "3": "good",
      "4": "strong"
    },
    "statusFromOrdinal": {
      "0": "FAIL",
      "1": "REVIEW_REQUIRED",
      "2-4": "PASS"
    },
    "note": "No aggregate cutoff is used for any decision; calibrated bands live in the golden set."
  },
  "statuses": {
    "NOT_APPLICABLE": "feature absent by design (never scored)",
    "NOT_MEASURED": "no evidence available (never 0, never PASS)",
    "REVIEW_REQUIRED": "ambiguous/insufficient/weak evidence",
    "FAIL": "demonstrated requirement failure",
    "PASS": "sufficient relevant evidence"
  },
  "assessors": {
    "DETERMINISTIC": "rule/measurement",
    "MODEL": "model judgment (cannot override deterministic or human failures)",
    "HUMAN": "explicit reviewer/owner judgment"
  },
  "hardBlockerCategories": [
    "FACTUAL",
    "RIGHTS",
    "SECURITY",
    "TECHNICAL_QA",
    "MISSING_ARTIFACT",
    "OWNER_APPROVAL"
  ],
  "hardBlockerRule": "Any P0/P1 hard blocker forces finalDecision=FAIL regardless of any score; owner overrides apply to P2/P3 subjective warnings only.",
  "dimensions": {
    "narration": {
      "applicability": "ALL",
      "owner": "NARRATION_TTS",
      "anchors": {
        "0": "unintelligible/clipped/wrong text spoken",
        "2": "intelligible, text matches script, no defects",
        "4": "natural, expressive, exact"
      },
      "requiresNonModelEvidenceForPass": true,
      "requiredFields": [
        "rubricVersion",
        "evidenceRefs",
        "confidence",
        "assessor",
        "findings",
        "actionableImprovement"
      ]
    },
    "scriptNaturalness": {
      "applicability": "ALL",
      "owner": "STORY_SCRIPT",
      "anchors": {
        "0": "robotic, repeated openers/patterns",
        "2": "readable, minor repetition",
        "4": "spoken-natural, varied rhythm"
      },
      "requiresNonModelEvidenceForPass": false,
      "requiredFields": [
        "rubricVersion",
        "evidenceRefs",
        "confidence",
        "assessor",
        "findings",
        "actionableImprovement"
      ]
    },
    "evidenceFidelity": {
      "applicability": "ALL",
      "owner": "RESEARCH_EVIDENCE",
      "anchors": {
        "0": "unsupported/contradicted claims",
        "2": "claims traceable to approved script/evidence",
